{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audisor.local/schemas/assistant/response.schema.json",
  "title": "Audisor assistant response envelope",
  "description": "Response of POST /v1/assistant/requests. The result payload is one of the per-mode contracts, a selection-required notice, or a sanitized error object. Responses never contain credentials, raw provider payloads, stack traces, hidden prompts, or filesystem paths.",
  "type": "object",
  "required": ["request_id", "mode", "status", "result", "warnings", "uncertainty"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": {
      "type": "string",
      "enum": [
        "fix_wording",
        "draft_three_replies",
        "translate_slang_jargon",
        "teach_clearly",
        "expand_idea",
        "visualize_design"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "uncertainty", "failed"]
    },
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/fixWordingResult" },
        { "$ref": "#/$defs/draftThreeRepliesResult" },
        { "$ref": "#/$defs/translateSlangJargonResult" },
        { "$ref": "#/$defs/teachClearlyResult" },
        { "$ref": "#/$defs/expandIdeaResult" },
        { "$ref": "#/$defs/visualizeDesignResult" },
        { "$ref": "#/$defs/selectionRequiredResult" },
        { "$ref": "#/$defs/errorResult" }
      ]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provider": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "source"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "enum": ["local", "cloud"] }
          }
        }
      ]
    },
    "usage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      ]
    },
    "engine": {
      "description": "Execution engine that produced the result (fix_wording only). Null when no engine selection applies.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "enum": ["model", "languagetool"] }
      ]
    },
    "fallback_used": {
      "description": "True when the configured engine failed and the fallback engine served the request.",
      "type": "boolean"
    },
    "fallback_reason": {
      "description": "Sanitized reason the fallback engine was used; empty when fallback_used is false.",
      "type": "string"
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accounting": {
      "description": "Sanitized usage-accounting evidence for the provider attempt. Null when accounting is disabled or unavailable; not_applicable for non-LLM engines.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/usageAccountingEvidence" }
      ]
    }
  },
  "$defs": {
    "usageAccountingEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "operation_id",
        "attempt_id",
        "provider",
        "model",
        "accounting_status"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "operation_id": { "type": "string", "minLength": 1 },
        "attempt_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "request_hash": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
        },
        "accounting_status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        },
        "estimate": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usageEstimate" }]
        },
        "actual": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/normalizedUsage" }]
        },
        "estimated_cost": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usageCost" }]
        },
        "actual_cost": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usageCost" }]
        },
        "context_decision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/admissionDecision" }]
        },
        "cost_decision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/admissionDecision" }]
        },
        "pricing_snapshot_sha256": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
        },
        "pricing_record_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "usageEstimate": {
      "type": "object",
      "required": [
        "input_tokens",
        "reserved_output_tokens",
        "estimated_total_tokens",
        "source",
        "confidence",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "reserved_output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_total_tokens": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/measurementSource" },
        "confidence": {
          "type": "string",
          "enum": ["exact", "provider_compatible", "approximate", "unavailable"]
        },
        "method": { "type": "string", "minLength": 1 },
        "fallback_reason": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "context_limit": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        }
      }
    },
    "normalizedUsage": {
      "type": "object",
      "required": ["source", "status"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "output_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "cached_read_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "cache_write_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "reasoning_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "total_tokens": { "$ref": "#/$defs/nullableTokenCount" },
        "source": { "$ref": "#/$defs/measurementSource" },
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        }
      }
    },
    "usageCost": {
      "type": "object",
      "required": [
        "currency",
        "uncached_input",
        "cached_read",
        "cached_write",
        "output",
        "reasoning",
        "total",
        "pricing_record_id",
        "pricing_snapshot_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": { "const": "USD" },
        "uncached_input": { "$ref": "#/$defs/decimalString" },
        "cached_read": { "$ref": "#/$defs/decimalString" },
        "cached_write": { "$ref": "#/$defs/decimalString" },
        "output": { "$ref": "#/$defs/decimalString" },
        "reasoning": { "$ref": "#/$defs/decimalString" },
        "total": { "$ref": "#/$defs/decimalString" },
        "pricing_record_id": { "type": "string", "minLength": 1 },
        "pricing_snapshot_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "admissionDecision": {
      "type": "object",
      "required": ["permitted"],
      "additionalProperties": false,
      "properties": {
        "permitted": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "measurementSource": {
      "type": "string",
      "enum": [
        "provider_reported",
        "local_exact",
        "provider_compatible",
        "approximate",
        "unavailable"
      ]
    },
    "nullableTokenCount": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
    },
    "decimalString": {
      "description": "Money serialized as an exact decimal string, never a float.",
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?(E[+-]?\\d+)?$"
    },
    "fixWordingResult": {
      "type": "object",
      "required": ["corrected_text"],
      "additionalProperties": false,
      "properties": {
        "corrected_text": { "type": "string" },
        "result_kind": {
          "description": "Semantic shape of this result: produced by a language model or assembled from LanguageTool matches.",
          "type": "string",
          "enum": ["model", "languagetool"]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["original", "correction", "reason"],
            "additionalProperties": false,
            "properties": {
              "original": { "type": "string" },
              "correction": { "type": "string" },
              "reason": { "type": "string" },
              "intentional_possible": { "type": "boolean" },
              "offset": {
                "description": "0-based character offset of the issue in the submitted text (grammar-checker results).",
                "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
              },
              "length": {
                "description": "Length in characters of the flagged span (grammar-checker results).",
                "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
              },
              "rule_id": {
                "description": "Grammar-checker rule identifier; empty for model-produced changes.",
                "type": "string"
              },
              "replacements": {
                "description": "Alternative replacements offered for the flagged span.",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "no_changes_needed": { "type": "boolean" },
        "inferred_intent": { "type": "string" },
        "tone": { "type": "string" },
        "context": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "draftThreeRepliesResult": {
      "type": "object",
      "required": ["in_short", "brief", "thorough", "diplomatic", "message_purpose", "tone"],
      "additionalProperties": false,
      "properties": {
        "in_short": { "type": "string" },
        "brief": { "type": "string" },
        "thorough": { "type": "string" },
        "diplomatic": { "type": "string" },
        "message_purpose": { "type": "string" },
        "tone": { "type": "string" },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "translateSlangJargonResult": {
      "type": "object",
      "required": ["term", "professional_translation", "plain_meaning", "origin_context", "example"],
      "additionalProperties": false,
      "properties": {
        "term": { "type": "string" },
        "professional_translation": { "type": "string" },
        "plain_meaning": { "type": "string" },
        "origin_context": { "type": "string" },
        "usage_notes": { "type": "array", "items": { "type": "string" } },
        "example": {
          "type": "object",
          "required": ["original", "professional"],
          "additionalProperties": false,
          "properties": {
            "original": { "type": "string" },
            "professional": { "type": "string" }
          }
        }
      }
    },
    "selectionRequiredResult": {
      "type": "object",
      "required": ["selection_required", "message"],
      "additionalProperties": false,
      "properties": {
        "selection_required": { "const": true },
        "message": { "type": "string" }
      }
    },
    "teachClearlyResult": {
      "type": "object",
      "required": ["basics", "why_this_matters"],
      "additionalProperties": false,
      "properties": {
        "basics": { "type": "string" },
        "building_from_there": { "type": "array", "items": { "type": "string" } },
        "key_insights": { "type": "array", "items": { "type": "string" } },
        "common_misconceptions": { "type": "array", "items": { "type": "string" } },
        "why_this_matters": { "type": "string" },
        "check_your_understanding": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expandIdeaResult": {
      "type": "object",
      "required": ["expanded_text", "preserved_intent"],
      "additionalProperties": false,
      "properties": {
        "expanded_text": { "type": "string" },
        "preserved_intent": { "type": "string" },
        "added_assumptions": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visualizeDesignResult": {
      "type": "object",
      "required": ["kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["layout", "workflow", "unclear"] },
        "summary": { "type": "string" },
        "collapsed": { "type": ["array", "null"], "items": { "type": "string" } },
        "expanded": { "type": ["array", "null"], "items": { "type": "string" } },
        "diagram_code": { "type": ["string", "null"] },
        "builder_prompt": { "type": ["string", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "errorResult": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["category", "message"],
          "additionalProperties": false,
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "configuration",
                "unavailable",
                "timeout",
                "authentication",
                "rate_limited",
                "invalid_response",
                "unsupported",
                "internal"
              ]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
